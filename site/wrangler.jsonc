{
	// Cloudflare Pages — static output only (no Worker script).
	// Deploy:  pnpm deploy   (= build + wrangler pages deploy build --project-name=ollanet)
	//
	// Do NOT also run Workers Builds / `wrangler deploy` from GitHub against this
	// same project while downpress is a local `link:` — CI can't see the sibling
	// engine and will publish broken versions that fight your local deploys
	// (intermittent 500s). Prefer one pipeline: local `pnpm deploy` until
	// downpress is a public git pin, then Pages Git with root directory `site`.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ollanet",
	"compatibility_date": "2026-08-10",
	"pages_build_output_dir": "build",
	"observability": {
		"enabled": true
	}
}
