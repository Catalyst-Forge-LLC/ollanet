{
	"name": "ollanet-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"docs:build": "node scripts/build-docs.mjs",
		"dev": "pnpm docs:build && node ../scripts/ensure-lease.mjs ollanet-site 5182 && filepress dev --host",
		"build": "pnpm docs:build && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=ollanet",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.6",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"getfilepress"
		]
	}
}
