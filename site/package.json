{
	"name": "ollanet-site",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"docs:build": "node scripts/build-docs.mjs",
		"dev": "pnpm docs:build && localslip claim ollanet-site --port 5182 && filepress dev --host 0.0.0.0",
		"build": "pnpm docs:build && filepress build",
		"preview": "filepress preview",
		"check": "filepress check",
		"ship": "pnpm build && wrangler pages deploy build --project-name=ollanet",
		"deploy": "pnpm ship"
	},
	"devDependencies": {
		"getfilepress": "^0.1.35",
		"wrangler": "^4.28.0"
	},
	"pnpm": {
		"overrides": {
			"sharp": "0.35.4",
			"cookie@<0.7.0": "0.7.2",
			"js-yaml": "3.15.2"
		},
		"onlyBuiltDependencies": [
			"getfilepress"
		]
	}
}
