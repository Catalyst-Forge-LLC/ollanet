{
  "name": "ollanet",
  "version": "0.3.0",
  "description": "Chat with Ollama servers on any reachable network — scan hosts, prompt models, continue chats by hash, MCP for agents",
  "type": "module",
  "bin": {
    "ollanet": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "tsc -p tsconfig.build.json",
    "ollanet": "tsx src/cli.ts",
    "scan": "tsx src/cli.ts scan",
    "prompt": "tsx src/cli.ts prompt",
    "chats": "tsx src/cli.ts chats",
    "bench": "tsx src/cli.ts bench",
    "mcp": "tsx src/cli.ts mcp",
    "start": "tsx src/cli.ts scan",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.build.json && node --test test/*.test.mjs",
    "test:only": "node --test test/*.test.mjs"
  },
  "keywords": [
    "ollama",
    "cli",
    "llm",
    "chat",
    "lan",
    "tailscale",
    "network",
    "mcp",
    "model-context-protocol"
  ],
  "author": "Catalyst Forge LLC",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Catalyst-Forge-LLC/ollanet.git"
  },
  "homepage": "https://github.com/Catalyst-Forge-LLC/ollanet#readme",
  "bugs": {
    "url": "https://github.com/Catalyst-Forge-LLC/ollanet/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@8.14.1",
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^5.8.3"
  }
}
